with "config/acp_codex_demo_config.gpr";

project ACP_Codex_Demo is
   for Source_Dirs use ("source", "../common", "config");
   for Object_Dir use ".obj/" & ACP_Codex_Demo_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("acp_codex_demo.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ACP_Codex_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end ACP_Codex_Demo;
